{
  "name": "jev-game-theory-arena",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:dom": "node tests/dom-suite.mjs",
    "verify:db": "npm exec --yes --include=optional --package=wrangler@4.147.0 -- wrangler d1 migrations apply jev-lab-verification --local --config worker/verification/wrangler.toml --persist-to .verification/state",
    "verify:worker": "npm exec --yes --include=optional --package=wrangler@4.147.0 -- wrangler dev --config worker/verification/wrangler.toml --port 8787 --persist-to .verification/state",
    "verify:api": "node scripts/verify-api.mjs",
    "verify:ui": "node scripts/verify-ui.mjs"
  },
  "devDependencies": {
    "jsdom": "30.1.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
